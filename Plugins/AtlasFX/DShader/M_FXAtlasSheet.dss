// M_FXAtlasSheet -- 图集帧采样材质（Niagara 精灵渲染器用）。
//
// 三个动态材质参数由 /AtlasFX/Modules/Play_SpriteAtlas 每帧写入
// （Particles.DynamicMaterialParameter / ...1 / ...2 → 材质 DynamicParameter 索引 0/1/2）：
//   索引 0 = 当前帧在图集里的像素矩形 (x, y, w, h)
//   索引 1 = 该帧在画布里的像素矩形 (x, y, w, h)；铺满模式下模块把它写成整块画布
//   索引 2 = 尺寸包 (.xy = 图集贴图宽高, .zw = 画布宽高)
//
// 采样方式 = 「画布还原」：面片按整块画布铺，帧放回它在画布里的位置，帧外透明。
// 铺满模式靠模块改写索引 1 复用同一套数学（Local 变成 TexCoord，UV 退化成整帧铺满），
// 所以这个材质不需要任何开关。
//
// 编译目标：/AtlasFX/M_FXAtlasSheet
//
// 2026-10-04 排查记录：「只有第 0 帧能显示」的真凶**不在这个材质里**，而是模块
// /AtlasFX/Modules/Play_SpriteAtlas 当时多写了一行 Particles.SubImageIndex = Frame。
// 精灵渲染器会把它当子图网格坐标掺进材质读到的 TexCoord（NiagaraSpriteVertexFactory.ush:1066/1068，
// SubImageSize=(1,1) 时 SubImageSize.z = 1 ⇒ TexCoord.y = 帧号 + UV.y），第 1 帧起整块面片采到贴图外。
// 定位手段就是下面这套「把三个动态参数画成颜色」的打点版：颜色按帧变 ⇒ 参数通路是好的；
// 打点版同时把 Mask 乘进亮度，Mask 恒 0 就说明 Local 被 TexCoord 的偏移带歪了。
// 正式版与打点版的数学完全相同，只是输出从「诊断配色」换回「采样结果」。
// ============================================================================

// 用法标记：精灵和网格两个渲染器共用同一个材质 —— 采样数学完全一样，差别只在渲染器喂进来的
// TexCoord 和面片朝向，所以没必要维护两份。引擎侧字段名是 bUsedWithNiagaraMeshParticles
// （Material.h:759，不是 bUsedWithNiagaraMeshes）。
// TwoSided：网格渲染器喂进来的面片绕序不一定朝相机，关掉背面剔除省得整个特效消失。
// 加性混合下面片只有一组三角形，双面不会出现「前后两层叠加变亮」的问题（Cube 才会）。
// ZDBridge 手搓的那张同用途材质也是这么配的（ZDBridgeEffectNiagara.cpp:229 Material->TwoSided = true）。
#pragma material(ShadingModel = Unlit, BlendMode = Additive, TwoSided = true, bUsedWithNiagaraSprites = true, bUsedWithNiagaraMeshParticles = true, Backend = Graph)

// 默认贴图**故意留空**（None）：插件资产不引用工程里的任何东西，示例图集随便删。
// 用的时候：直接改这个材质的 Sheet，或者建材质实例只覆盖 Sheet（推荐 —— 一个图集一个 MI）。
// 留空时 UE 会用引擎的默认贴图兜底，画面是纯色而不是报错。
// 注意：这里**不写** `/// @default`（写了就必须给一个能加载的资产；`None` 会被 DSH8218 拒绝）。
// 不写 = 属性保持引擎默认的空值，正好是我们想要的效果。
/// @group Atlas   @desc 图集贴图：用哪个图集就指哪张（Flipbook 模式和手工兜底模式都用它）
uniform Texture2D Sheet;

// ============================================================================
// 2026-10-04 UV 探针排查结论（已换回正式版）：
//   面片呈「黑→红/绿渐变 + 整块偏蓝」⇒ ① 网格 TexCoord 落在 0..1（正常）；
//   ② 蓝 = DMP0.z + DMP0.w > 0.5 ⇒ **三个动态材质参数确实送到了**。
//   两条前提都成立，所以正式版的画布还原数学可以直接用。
// ============================================================================
export void M_FXAtlasSheet(inout material m)
{
    // 当前帧在图集里的像素矩形
    float4 AtlasRect = UE.Expression(Class = "DynamicParameter", ParameterIndex = 0).RGBA;
    // 该帧在画布里的像素矩形
    float4 CanvasRect = UE.Expression(Class = "DynamicParameter", ParameterIndex = 1).RGBA;
    // 尺寸包：.xy = 图集贴图宽高，.zw = 画布宽高
    float4 Sizes = UE.Expression(Class = "DynamicParameter", ParameterIndex = 2).RGBA;

    // ── 正常路径：画布还原 ──────────────────────────────────────────────
    // 面片 UV（0..1）→ 画布像素坐标 → 帧内 0..1
    float2 CanvasPx = UE.TexCoord(Index = 0) * Sizes.zw;
    float2 Local = (CanvasPx - CanvasRect.xy) / CanvasRect.zw;

    // 帧外一律透明（画布还原时面片比帧大，多出来的部分是空的）
    float2 InFrame = step(0.0, Local) * step(Local, 1.0);
    float Mask = InFrame.x * InFrame.y;

    // 帧内 0..1 → 图集里的实际 UV
    float2 UV = (AtlasRect.xy + Local * AtlasRect.zw) / Sizes.xy;
    float4 CMain = Sheet.Sample(UV) * Mask;

    // ── 兜底路径：三个动态参数全是 0 ────────────────────────────────────
    // 出现这种情况说明上游没送数据（材质编辑器预览里本来就没有粒子数据；
    // 运行时出现就说明 Play_SpriteAtlas 那三个写入没生效）。
    // 此时直接用网格自己的 UV 采样整张贴图 —— 保证材质任何时候都有东西可看，
    // 而且它本身就是判据：**网格上出现"整张图集"= 三个动态参数没送到**。
    // 用加法求和判零而不是分支：这个材质要保持无分支（分支会在 VM/着色器编译上踩坑）。
    float DataSum = Sizes.x + Sizes.y + Sizes.z + Sizes.w + CanvasRect.z + CanvasRect.w;
    float NoData = step(DataSum, 0.0001);
    float4 CFallback = Sheet.Sample(UE.TexCoord(Index = 0));
    float4 C = lerp(CMain, CFallback, NoData);

    // Additive 的像素着色器输出是 Color * Opacity（BasePassPixelShader.usf:2325-2327），
    // 所以「颜色给采样值、透明度给采样 alpha」= 预乘式的加性精灵，正是闪电要的。
    m.EmissiveColor = C.rgb;
    m.Opacity = C.a;
}
