// M_FXAtlasSheet -- 图集帧采样材质（Niagara 精灵渲染器用）。
//
// 三个动态材质参数由 /AtlasFX/Modules/Play_SpriteAtlas 每帧写入
// （Particles.DynamicMaterialParameter / ...1 / ...2 → 材质 DynamicParameter 索引 0/1/2）：
//   索引 0 = 当前帧在图集里的像素矩形 (x, y, w, h)
//   索引 1 = 该帧在画布里的像素矩形 (x, y, w, h)；铺满模式下模块把它写成整块画布
//   索引 2 = 尺寸包 (.xy = 图集贴图宽高, .zw = 画布宽高)
//
// 采样方式 = 「画布还原」：面片按整块画布铺，帧放回它在画布里的位置，帧外透明。
// 铺满模式靠模块改写索引 1 复用同一套数学（Local 变成 TexCoord，UV 退化成整帧铺满），
// 所以这个材质不需要任何开关。
//
// 透明度 = 贴图 alpha × 粒子颜色 alpha（Particle Color 节点的 A）。
// ⇒ Niagara 侧用内置模块 Scale Color（Scale Alpha / Scale RGBA）或 Color 模块、
//   或者直接写 Particles.Color.a，就能控制整个特效的淡入淡出（2026-10-10 加，
//   细节与源码出处见函数体里的「粒子颜色」那一段注释）。
//
// 编译目标：/AtlasFX/M_FXAtlasSheet
//
// 2026-10-04 排查记录：「只有第 0 帧能显示」的真凶**不在这个材质里**，而是模块
// /AtlasFX/Modules/Play_SpriteAtlas 当时多写了一行 Particles.SubImageIndex = Frame。
// 精灵渲染器会把它当子图网格坐标掺进材质读到的 TexCoord（NiagaraSpriteVertexFactory.ush:1066/1068，
// SubImageSize=(1,1) 时 SubImageSize.z = 1 ⇒ TexCoord.y = 帧号 + UV.y），第 1 帧起整块面片采到贴图外。
// 定位手段就是下面这套「把三个动态参数画成颜色」的打点版：颜色按帧变 ⇒ 参数通路是好的；
// 打点版同时把 Mask 乘进亮度，Mask 恒 0 就说明 Local 被 TexCoord 的偏移带歪了。
// 正式版与打点版的数学完全相同，只是输出从「诊断配色」换回「采样结果」。
// ============================================================================

// 用法标记：精灵和网格两个渲染器共用同一个材质 —— 采样数学完全一样，差别只在渲染器喂进来的
// TexCoord 和面片朝向，所以没必要维护两份。引擎侧字段名是 bUsedWithNiagaraMeshParticles
// （Material.h:759，不是 bUsedWithNiagaraMeshes）。
// TwoSided：网格渲染器喂进来的面片绕序不一定朝相机，关掉背面剔除省得整个特效消失。
// Translucent 下双面要注意「同一像素被前后两层各混一次」，但精灵/网格粒子都是一组三角形
// 的单层面片（Cube 才会真有两层），所以这里不需要额外处理。
// ZDBridge 手搓的那张同用途材质也是这么配的（ZDBridgeEffectNiagara.cpp:229 Material->TwoSided = true）。
//
// 2026-10-09 BlendMode 从 Additive 改为 Translucent：用户反馈"Alpha 没了"——
// Additive 的像素输出是 Color * Opacity 加到背景上，透明区只是"不加亮"，
// 背景亮的地方看不出精灵边界，暗部也不会被精灵遮住，所以观感上像丢了 Alpha。
// Translucent 走的是标准 alpha 混合（Unlit 下最终色 = EmissiveColor，再按 Opacity 混合），
// 精灵能真正遮住背景，边缘半透也会保留。想要发光感就建材质实例单独用 Additive 版本。
#pragma material(ShadingModel = Unlit, BlendMode = Translucent, TwoSided = true, bUsedWithNiagaraSprites = true, bUsedWithNiagaraMeshParticles = true, Backend = Graph)

// 默认贴图**故意留空**（None）：插件资产不引用工程里的任何东西，示例图集随便删。
// 用的时候：直接改这个材质的 Sheet，或者建材质实例只覆盖 Sheet（推荐 —— 一个图集一个 MI）。
// 留空时 UE 会用引擎的默认贴图兜底，画面是纯色而不是报错。
// 注意：这里**不写** `/// @default`（写了就必须给一个能加载的资产；`None` 会被 DSH8218 拒绝）。
// 不写 = 属性保持引擎默认的空值，正好是我们想要的效果。
/// @group Atlas   @desc 图集贴图：用哪个图集就指哪张（Flipbook 模式和手工兜底模式都用它）
uniform Texture2D Sheet;

// ============================================================================
// 2026-10-04 UV 探针排查结论（已换回正式版）：
//   面片呈「黑→红/绿渐变 + 整块偏蓝」⇒ ① 网格 TexCoord 落在 0..1（正常）；
//   ② 蓝 = DMP0.z + DMP0.w > 0.5 ⇒ **三个动态材质参数确实送到了**。
//   两条前提都成立，所以正式版的画布还原数学可以直接用。
// ============================================================================
export void M_FXAtlasSheet(inout material m)
{
    // 当前帧在图集里的像素矩形
    float4 AtlasRect = UE.Expression(Class = "DynamicParameter", ParameterIndex = 0).RGBA;
    // 该帧在画布里的像素矩形
    float4 CanvasRect = UE.Expression(Class = "DynamicParameter", ParameterIndex = 1).RGBA;
    // 尺寸包：.xy = 图集贴图宽高，.zw = 画布宽高
    float4 Sizes = UE.Expression(Class = "DynamicParameter", ParameterIndex = 2).RGBA;

    // ── 正常路径：画布还原 ──────────────────────────────────────────────
    // 面片 UV（0..1）→ 画布像素坐标 → 帧内 0..1
    float2 CanvasPx = UE.TexCoord(Index = 0) * Sizes.zw;
    float2 Local = (CanvasPx - CanvasRect.xy) / CanvasRect.zw;

    // 帧外一律透明（画布还原时面片比帧大，多出来的部分是空的）
    float2 InFrame = step(0.0, Local) * step(Local, 1.0);
    float Mask = InFrame.x * InFrame.y;

    // 帧内 0..1 → 图集里的实际 UV。
    // saturate 是保险丝：Sizes.xy 一旦被上游写坏（实测：贴图平台数据还在异步编译时
    // GetSizeX() 返回引擎替身尺寸 32×32），UV 会远大于 1 ⇒ 图集在面片里平铺成
    // 「一坨细碎条纹」。夹到 [0,1] 后最坏只是采错一块，不会花屏；正常情况
    // （所有矩形都在贴图内）它是恒等变换。
    float2 UV = saturate((AtlasRect.xy + Local * AtlasRect.zw) / Sizes.xy);
    float4 CMain = Sheet.Sample(UV) * Mask;

    // ── 兜底路径：三个动态参数全是 0 ────────────────────────────────────
    // 出现这种情况说明上游没送数据（材质编辑器预览里本来就没有粒子数据；
    // 运行时出现就说明 Play_SpriteAtlas 那三个写入没生效）。
    // 此时直接用网格自己的 UV 采样整张贴图 —— 保证材质任何时候都有东西可看，
    // 而且它本身就是判据：**网格上出现"整张图集"= 三个动态参数没送到**。
    // 用加法求和判零而不是分支：这个材质要保持无分支（分支会在 VM/着色器编译上踩坑）。
    float DataSum = Sizes.x + Sizes.y + Sizes.z + Sizes.w + CanvasRect.z + CanvasRect.w;
    float NoData = step(DataSum, 0.0001);
    float4 CFallback = Sheet.Sample(UE.TexCoord(Index = 0));
    float4 C = lerp(CMain, CFallback, NoData);

    // ── 粒子颜色：Alpha 通道交给 Niagara 侧控制（2026-10-10 加）────────────────
    // 需求（用户原话）："让他能被 Scale Color 控制，或者其他办法，只要能控制 Alpha 就行"。
    //
    // 为什么原来控制不了：这个材质的 Opacity 只用了贴图自己的 alpha，而 Niagara 的
    // Scale Color / Color 模块写的是 Particles.Color —— 两者本来就没有通路。
    //
    // 引擎链路（全部核过源码，不是猜的）：
    //   ① 渲染器的颜色绑定默认就指向 Particles.Color，不用手接：
    //      NiagaraMeshRendererProperties.cpp:644 / NiagaraSpriteRendererProperties.cpp:296
    //      `ColorBinding = FNiagaraConstants::GetAttributeDefaultBinding(SYS_PARAM_PARTICLES_COLOR)`；
    //   ② 粒子颜色进 VF 后被顶点工厂插值到像素阶段：
    //      NiagaraSpriteVertexFactory.ush:139（顶点插值器）→ :354
    //      `Result.Particle.Color = Interpolants.Color`（PS）；
    //      NiagaraMeshVertexFactory.ush:101 / :288 / :787（同构，走 COLOR1 插值器）；
    //   ③ 材质里要用 **Particle Color 节点** 才读得到它：
    //      UMaterialExpressionParticleColor::Compile → Compiler->ParticleColor()
    //      （MaterialExpressions.cpp:10086）→ 外部代码块 "ParticleColor"，
    //      定义在 Engine/Config/BaseMaterialExpressions.ini:1056
    //      `Definition="Parameters.Particle.Color"`，并顺带打开 NEEDS_PARTICLE_COLOR
    //      （像素阶段）—— 上面 ② 那几段插值代码全在这个宏里，所以**不写这个节点，
    //      粒子颜色根本不会传到像素**，这就是之前「改了 Scale Color 没反应」的机制。
    //
    // ⚠️ 只把 **Alpha** 乘进 Opacity，**故意不乘 RGB**：
    //   Particles.Color 的默认值是纯白（渲染器兜底也是 FVector4f(1,1,1,1)，
    //   NiagaraRendererSprites.cpp:573 / NiagaraRendererMeshes.cpp:1006），
    //   所以「没人写它」时这一乘法是恒等变换，存量特效一个字都不会变。
    //   但 Scale Color 的 "Scale RGBA Together" 模式会连 RGB 一起压暗 —— 若把 RGB 也乘进来，
    //   用它做淡出的特效会同时被压成黑块（Translucent 下就是一块黑）。既然需求是「控制 Alpha」，
    //   就只让 A 生效，RGB 保持贴图原色。**要 RGB 也受控**：把下面 EmissiveColor 那行
    //   改成 `C.rgb * ParticleCol.rgb` 即可（记得 Scale Color 用 "RGB and Alpha Separately"）。
    // ⚠️ 写法与上面三个动态参数**完全同构**：`Class=` + 属性 + `.RGBA` 取满通道。
    //   这个 `.dss`（2.0 文本源）不接受 `OutputType=` —— 那是 1.x（`.dsm`/`.dsf`）Graph 面的参数；
    //   在这里写它会报 DSH5213（'UE.ParticleColor' has no pin or property called 'OutputType'）
    //   + DSH4202（字符串只能当**反射属性**的值）。
    //   `.RGBA` 不是随手写的 swizzle：这个节点的输出是**具名**的
    //   （MaterialExpressions.cpp:10074-10079：RGB / R / G / B / A / **RGBA**），
    //   选名字为 `RGBA` 的那一路（mask 1,1,1,1）正好拿到完整 float4，所以不用声明宽度。
    float4 ParticleCol = UE.Expression(Class = "ParticleColor").RGBA;

    // Unlit + Translucent 的最终色就是 EmissiveColor，再按 Opacity 做 alpha 混合
    // （不透明处遮住背景、半透处保留渐变）。所以这里给「颜色 = 采样值、透明度 = 采样 alpha × 粒子 alpha」，
    // 采样 alpha 为 0 的地方（帧外、贴图透明区）完全不显示；
    // 粒子 alpha 为 0 的地方整个特效消失 —— 这就是 Niagara 侧 Scale Color 的「Scale Alpha」、
    // 或 Color 模块 / 直接写 Particles.Color.a 能控制的那一路。
    m.EmissiveColor = C.rgb;
    m.Opacity = C.a * ParticleCol.a;
}
