 {
  "asset": "Item_Misaka",
  "item": {
   "Name": "\"御坂美琴\"",
   "Description": "\"御坂美琴是常盘台中学二年级学生，在学园都市七名Level 5中排名第三。她能够操纵电流与电磁力，因为经常用硬币发射超电磁炮，也被人直接称作“超电磁炮”。",
   "Icon": "<TSoftObjectPtr<UTexture2D>>",
   "Type": "<对象引用，跳过>",
   "Count": "1",
   "MaxCount": "1",
   "KeyWords": "(\"Misaka\",\"御坂美琴\",\"魔法禁书目录\",\"某科学的超电磁炮\",\"学生\",\"初中二年级\",\"电击\",\"异能攻击\",\"常盘台中学\",\"超能力者\",\"电击使\",\"哔哩哔哩\",\"超电磁炮\",\"Bilibili\",\"LV5\",\"平板\",\"最强人类\")"
  },
  "char": {
   "CharShapeNow": "0",
   "CharShapeHas": "(True,False)",
   "CharShapeIcon": "(?,?)",
   "CharShapeGroup": "(?,?)",
   "CharShapeComplete": "(?,?)",
   "SkillNow": "(5,1,2,3,4,0,0)",
   "SkillHave": "(True,True,True,True,True)",
   "SkillData": "(?,?,?,?,?,?,?)",
   "SkillLevel": "(1,1,1,1)",
   "SkillDescription": "(\"【电磁屏障】/自身受到的反击伤害-52%，自身造成的反击伤害+52%，拼刀成功后的击飞距离翻倍，如果御坂处于反击守备状态中，敌方攻击御坂（单体伤害）的守备状态会被替换为反击\",\"【高傲的自尊】/自己拼刀失败后或者当自己的攻击没有对敌方造成伤害时：给敌方施加【给我等着！】\",\"【哔哩哔哩】/如果我放有人行动时丢弃了技能，御坂会追加一次随机敌方的落雷\",\"【磁控溅射】/当敌方有3位拥有【给我等着！】标记，那么下一次落雷会变成超大范围落雷，麻痹对方全体一回合，随后清除对方身上的【给我等着！】标记\")",
   "Speed": "720",
   "Health": "2000",
   "Attack": "50",
   "PhyDefense": "50",
   "MagDefense": "50",
   "Critical": "10",
   "CriticalC": "10",
   "Synchronize": "0"
  },
