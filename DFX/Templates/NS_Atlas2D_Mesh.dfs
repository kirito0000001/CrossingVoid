// NS_Atlas2D_Mesh —— AtlasFX「网格渲染器」模板（文本源，DreamFX 生成）。
// 默认**不挂**图集（Atlas 留空）：模板不引用工程里的任何资产，随便删示例文件都不会被牵连。
// 用的时候把下面 Properties 里 Atlas 的 Flipbook 指到自己的图集即可。
//
// 和精灵模板（NS_Atlas2D_Sprite）的区别只有三处：
//   1. 多挂一个 /AtlasFX/Modules/Sprite_Atlas_Size —— Mesh 渲染器读 Particles.Scale，
//      不读 Particles.SpriteSize，这个模块把播放模块算好的尺寸换算过去，顺带摆正面片朝向；
//   2. 渲染器从 SpriteRenderer 换成 MeshRenderer；
//   3. 材质不用换 —— /AtlasFX/M_FXAtlasSheet 同时开了精灵和网格两个用法标记。
//
// 采样数学、DI、播放模块三者与 Sprite 版完全一致 ⇒ 两版画面应当逐帧对得上。
//
// 播放契约（2026-10-05 按用户要求定）：一颗粒子 = 一次干净的播放 ——
//   帧速度 = Flipbook 帧率（Play_SpriteAtlas 的 PlayMode 0）；
//   时长   = Flipbook 总时长（Sprite_Atlas_Duration：帧数 ÷ 帧率 = 6 ÷ 15 = 0.4 秒）；
//   默认只播一遍（Play_SpriteAtlas 的 Loop = 0，播完停在最后一帧）；
//   发射器一次性（EmitterState Once + Complete，t = 0 只发一颗粒子）。
//
// 改这个文件后：pwsh -File Plugins/DreamFX/.skill/dfx.ps1 build DFX/Templates/NS_Atlas2D_Mesh.dfs
//
// ⚠️⚠️ 重建之后**必须再跑一次**命令工具，否则从模板新建的网格特效会渲染成一整块惨白方块：
//   UnrealEditor-Cmd.exe CrossingVoid.uproject -run=AtlasFXSetup -stdout -unattended -nopause -nosplash
//   原因：渲染器上那条「Sheet 纹理槽 + Sheet ← User.Atlas.ResolvedTexture 属性绑定」是命令工具
//   （SeedRendererMaterialParameters）事后补的，DFX 的 .dfs 表达不了「材质参数 → 属性绑定」，
//   而 DFX 重建 = 按文本重新生成渲染器 ⇒ 补的东西就没了。详见 Plugins/AtlasFX/DESIGN.md §20.2。
System(Name="Templates/NS_Atlas2D_Mesh", Root="Plugin.AtlasFX")
{
    Settings = {
        WarmupTime  = 0.0;
        FixedBounds = box(-300, -300, -300, 300, 300, 300);
        ModulePaths = [ "/AtlasFX/Modules" ];
    }

    Properties = {
        // 故意留空（裸声明 = 运行时再填的空槽）：模板不引用工程里的图集资产。用的时候填自己的 Flipbook：
        //   DI<SpriteAtlas> Atlas = "{\"Flipbook\":\"/Game/你的目录/你的Flipbook.你的Flipbook\"}";
        DI<SpriteAtlas> Atlas;

        float SizeScale  = 0.5 [ Group="图集"; SortPriority=10;
            Description="1 像素对应多少世界单位（1.0 = 1 厘米，即 UE 默认单位）。面片尺寸 = 目标尺寸 × 这个值：默认 0.5 时画布 928×640 = 4.64×3.2 米，闪电本体约 0.85～1.8 米；想要更大直接乘。" ];
        float FitFrame   = 0.0 [ Group="图集"; SortPriority=12;
            Description="面片取哪个尺寸：0 = 画布还原（面片 = 整块画布 928×640，默认）；1 = 铺满（面片 = 当前帧自己的矩形）。" ];
        float PlayMode   = 0.0 [ Group="图集"; SortPriority=15;
            Description="播放模式：0 = 按 Flipbook 帧率（默认）；1 = 按粒子生命长度播完一遍；2 = 用 FrameIndex 直接指定帧号。" ];
        float StartFrame = 0.0 [ Group="图集"; SortPriority=20;
            Description="起始帧偏移。接 Random Float in Range 就是随机起帧。" ];
        float FrameIndex = 0.0 [ Group="图集"; SortPriority=25;
            Description="模式2专用：直接指定当前帧号（可接 Float from Curve 做曲线控制）。" ];
        float PlayRate   = 1.0 [ Group="图集"; SortPriority=30;
            Description="播放速率倍率，负值倒放。" ];

        // ---- Mesh 渲染器专属 ----
        // 朝向（MeshYaw）**故意不做成用户参数**：本工程的答案恒为 0（面片自然朝向即正对镜头），
        // 写死在下面的模块调用里。做成用户参数只会多一个面板行，而且改它的默认值**不会**
        // 刷新资产里的存量值（重编不重置用户参数 —— 实测踩过，面板上会一直显示旧值，看着像 bug）。
        // 换网格（比如法线在 X 上的工程面片）或画面镜像时，直接改下面调用里的 0.0 即可。
        float DepthScale = 1.0 [ Group="图集|网格"; SortPriority=40;
            Description="厚度（网格局部 Y 方向的缩放）。真正的平面网格保持 1.0；拿 Cube 当薄片用时调小，例如 0.05 = 5 厘米厚。" ];
    }

    Emitter Atlas2D_Mesh
    {
        Settings = {
            SimTarget          = CPU;      // 数据接口第一步只支持 CPU
            LocalSpace         = true;     // 本地空间：粒子不随发射器移动（跟随特效挂点/角色走）
            Determinism        = true;
            RandomSeed         = 1337;
            AllocationMode     = Fixed;
            PreAllocationCount = 8;
        }

        EmitterUpdate = {
            // 一次性发射器（2026-10-05 按用户要求改）：只发一发，之后发射器自己收工。
            // 形状照抄工程里能用的 Leng刀光：Self + Once + Complete + LoopDuration = 1.0。
            //   InactiveResponse = Complete ⇒ 粒子全部死光后发射器进入完成状态；
            //   LoopBehavior     = Once     ⇒ 不循环；
            //   LoopDuration     = 1.0      ⇒ 发射器最多活跃 1 秒（粒子自己 0.4 秒就寿终了，
            //                                 这 1 秒是给发射器留的收尾时间）。
            EmitterState(
                LifeCycleMode    = Self,
                InactiveResponse = Complete,
                LoopBehavior     = Once,
                LoopDurationMode = Fixed,
                LoopDuration     = 1.0
            );

            // 唯一的一发：t = 0 立刻生成 1 颗粒子。
            // （之前这里还有 SpawnRate(1.0) 做「每秒一发」的循环发射 —— 一次性特效不需要它了。）
            SpawnBurst_Instantaneous(SpawnCount = 1, SpawnTime = 0.0);
        }

        ParticleSpawn = {
            Spawn/Initialization/V2/InitializeParticle(
                LifetimeMode = DirectSet,
                Lifetime     = 0.4   // 兜底值 = 图集时长（6 帧 ÷ 15 帧/秒）；下一行的模块会按 DI 实际值重算
            );

            // 寿命对齐图集动画的总时长（帧数 ÷ 帧率）—— 用户要的「时长也一样」那半。
            // 必须紧跟 InitializeParticle：寿命要在粒子出生的那一帧定下来
            // （Play_Sprite_Atlas 是 ParticleUpdate，那时候改 Lifetime 只会让年龄跳变）。
            Sprite_Atlas_Duration(Atlas = User.Atlas);

            // 网格特效默认整体抬 40（**世界单位**）：角色精灵组件在 Z = +40（Misaka 蓝图的 Sprite），
            // 网格特效跟着抬才和精灵那套对齐（2026-10-06 用户定）。
            // 加在**粒子位置**上 ⇒ 不受 Particles.Scale 放大（挪面片原点会被放大，是死路：
            // 模板默认配置下 Scale = 5，局部 40 变世界 200，而且每个系统的 SizeScale 还不一样）。
            // 要调 / 要关：直接改这里的 Offset；某个系统的通知 Offset 里已经算过这 40 的话，
            // 把它改成 (0.0, 0.0, 0.0)，否则会叠加成 80。
            // ⚠️ 必须留在 ParticleSpawn（位置逐帧累积，放 ParticleUpdate 会越跑越远）。
            Atlas_Mesh_Offset(Offset = (0.0, 0.0, 40.0));
        }

        ParticleUpdate = {
            // 顺序要紧：ParticleState 给年龄 → Play_SpriteAtlas 算帧并写 SpriteSize
            // → Sprite_Atlas_Size 读 SpriteSize 换算 Scale 并摆正朝向。Niagara 按栈序执行。
            ParticleState();

            Play_SpriteAtlas(
                Atlas      = User.Atlas,
                PlayMode   = User.PlayMode,
                SizeScale  = User.SizeScale,
                FitFrame   = User.FitFrame,
                StartFrame = User.StartFrame,
                FrameIndex = User.FrameIndex,
                PlayRate   = User.PlayRate,
                // Loop 显式写死 0.0（只播一遍，播完停在最后一帧）—— **故意不做成用户参数**：
                // 本工程默认就是「一次干净的播放」，想让它循环就把这里改成 1.0
                // （同上面 MeshYaw 的理由：避免面板上留一个改默认值不刷新的存量行）。
                Loop       = 0.0
            );

            // ⚠️ MeshYaw 显式写死 0.0，**不要**传 User.MeshYaw：
            //    资产里的用户参数 MeshYaw 还存着旧值（重编不会重置用户参数 —— 实测踩过），
            //    传它就可能把面片转成侧对镜头 ⇒ 完全看不见。
            //    0 的含义：FXDefault 的面法线在局部 Y 上，本工程 2D 相机也沿 Y 轴看
            //    （Paper2D 侧视；PaperZD 预览相机 (0,-100,0) 朝 +Y，与游戏同轴），
            //    所以面片保持自然朝向就正对镜头，不需要任何补偿。配合下面的 FacingMode 默认值，
            //    面片就固定在发射器局部平面里、并可以跟着发射器/挂点一起转。
            Sprite_Atlas_Size(
                MeshSize   = (92.8, 64.0),
                DepthScale = User.DepthScale,
                MeshYaw    = 0.0
            );
        }

        MeshRenderer Mesh
        {
            // 用工程自己的面片（ZDBridge 插件里的 FXDefault）而不是引擎自带 Cube。
            // FXDefault 是一张平躺在 X–Z 平面里的面片：**面法线在局部 Y 上**，
            // 宽沿局部 X（92.8）、高沿局部 Z（64.0）。
            // 轴心：2026-10-06 起在**几何中心**（FBX 顶点 Z ±0.32 ⇒ 导入后 ±32）。
            // 在那之前轴心在**底边**（Z 0…64）—— 面片从粒子原点往上长，同一份数据网格版比
            // 精灵版整体高「画出来高度的一半」（Misaka 那边实测 120 cm）。轴心居中之后两版
            // 天然对齐，**不要再加任何 Z 补偿**（加了反而偏低）。
            // 本工程 2D 相机沿 Y 轴看（Paper2D 侧视：X 左右、Z 上下、Y 景深），
            // 面片法线正好也在 Y 上 ⇒ **自然朝向就正对镜头**，Sprite_Atlas_Size 传 MeshYaw = 0。
            Meshes     = ["/ZDBridge/FX/FXDefault"];

            // ⚠️ 网格渲染器**没有** Material 字段（NiagaraMeshRendererProperties.h:196
            //    "If Override Material is not specified, the mesh's material is used."），
            //    要挂自己的材质必须走「启用材质重载」这两个属性。写 Material = "..." 会被
            //    DreamFX 静默丢掉（它按反射找 FObjectProperty "Material"，网格渲染器上找不到，
            //    直接 return true 什么都不报）—— 这是踩过的坑。
            //
            // ⚠️ 只写 OverrideMaterials 数组还不够！引擎里是**两个**属性：
            //    `bOverrideMaterials`（NiagaraMeshRendererProperties.h:226，界面上的「启用材质重载」，
            //    构造函数默认 false —— NiagaraMeshRendererProperties.cpp:424 `bOverrideMaterials(false)`）
            //    和 `OverrideMaterials` 数组（:273）。渲染时只看前者（:917 / :1140
            //    `if (bOverrideMaterials)`），不勾选就仍然用网格自带的材质（FXDefault 上是
            //    WorldGridMaterial ⇒ 画面上是灰白棋盘格）。DreamFX 只认识数组那个，开关得自己写。
            OverrideMaterials  = ["/AtlasFX/M_FXAtlasSheet"];
            bOverrideMaterials = true;
            // 子图不混合：一帧一帧硬切，不做相邻子图之间的插值（工程里 Leng刀光 也是 false）。
            // 网格渲染器构造函数默认是 true（NiagaraMeshRendererProperties.cpp:426），
            // 版本升级路径又会把它改成 false（:603），所以新旧资产值不一样。
            bSubImageBlend     = false;

            // ── 朝向：**故意不写 FacingMode**，走默认的 Default（本地空间朝向）──────
            // 这是本工程网格特效的标准做法 —— 参考 /Game/GameActor2D/SAO_Kirito/ExAsset/Leng刀光，
            // 它的 MeshRenderer 块里同样没有 FacingMode 这一行。
            //
            // 引擎机制（NiagaraMeshParticleUtils.ush）：
            //   `:365 if (FacingMode != MESH_FACING_DEFAULT)` 才计算并乘上朝向矩阵
            //   `:369 SRT.Rotation = mul(SRT.Rotation, FacingMat)` —— 朝向矩阵在粒子自身旋转
            //   **之后**叠加，等于**覆盖**掉粒子写的旋转。
            //   `:262 FacingDir = -CameraForwardDir`、`:305 RefVector = Params.CameraUpDir`
            //   ⇒ CameraPlane/CameraPosition/Velocity 这三种模式都是"每帧拿相机重建朝向"。
            //
            // 所以 Default 与 CameraPlane 的区别是本质性的：
            //   Default      = 完全不套朝向矩阵 ⇒ 网格保持自己的局部朝向，可以被特效旋转，
            //                  配合发射器 LocalSpace = true，面片跟着发射器/挂点一起转。
            //   CameraPlane  = 每帧朝相机 ⇒ **特效永远转不动它**（CameraPlane 下
            //                  Particles.MeshOrientation 写了也白写），而且始终跟随相机。
            //                  实测现象：拖动视口时面片跟着相机转、色彩线抖动。
            // 我们要的是前者：2D 特效的面片应当固定在发射器局部平面里、朝向由面片自身的
            // 自然朝向决定（本工程里法线就在 Y 上，正好对着相机），而不是让编辑器自由相机牵着走。
            SortMode = ViewDepth;

            // 排序：和 Leng刀光 一样按归一化年龄排，同一时刻的帧前后关系稳定。
            Bind CustomSorting -> Particles.NormalizedAge;

            Bind Scale -> Particles.Scale;
            Bind Color -> Particles.Color;
        }
    }

}
