// NS_Atlas2D_Sprite —— AtlasFX「精灵渲染器」模板（文本源，DreamFX 生成）。
// 默认**不挂**图集（Atlas 留空）：模板不引用工程里的任何资产，随便删示例文件都不会被牵连。
// 用的时候把下面 Properties 里 Atlas 的 Flipbook 指到自己的图集即可。
//
// 数据层：AtlasFX 插件的 C++ 数据接口 UNiagaraDataInterfaceSpriteAtlas（只支持 CPU 模拟）。
// 播放层：/AtlasFX/Modules/Play_SpriteAtlas —— 由 DFX/Modules/M_PlaySpriteAtlas.dfm 生成，
//         按 PlayMode 推进帧号（默认 0 = 按 Flipbook 帧率），并把当前帧的
//         「图集矩形 / 画布矩形 / 尺寸包」写进 Particles.DynamicMaterialParameter（材质索引 0/1/2）。
// 采样层：/AtlasFX/M_FXAtlasSheet —— Unlit + Additive，按「画布还原」采样：
//         面片 = 画布尺寸，帧放回它在画布里的位置（用 DynamicParameter 0/1/2）。
//
// 播放契约（2026-10-05 按用户要求定）：一颗粒子 = 一次干净的播放 ——
//   帧速度 = Flipbook 帧率（Play_SpriteAtlas 的 PlayMode 0）；
//   时长   = Flipbook 总时长（Sprite_Atlas_Duration：帧数 ÷ 帧率 = 6 ÷ 15 = 0.4 秒）；
//   默认只播一遍（Play_SpriteAtlas 的 Loop = 0，播完停在最后一帧）；
//   发射器一次性（EmitterState Once + Complete，t = 0 只发一颗粒子）。
//
// 改这个文件后：关掉编辑器 → pwsh -File Plugins/DreamFX/.skill/dfx.ps1 build DFX/Templates/NS_Atlas2D_Sprite.dfs
System(Name="Templates/NS_Atlas2D_Sprite", Root="Plugin.AtlasFX")
{
    Settings = {
        WarmupTime  = 0.0;
        FixedBounds = box(-300, -300, -300, 300, 300, 300);

        // 让 Play_SpriteAtlas 这个短名能被解析到 /AtlasFX/Modules 下。
        // ModulePaths 是「追加」搜索根，不会顶掉引擎自带的 /Niagara/Modules。
        ModulePaths = [ "/AtlasFX/Modules" ];
    }

    Properties = {
        // 数据接口参数的配置是「一个 JSON 对象字符串」。对象引用写裸路径字符串
        // （导出器会写成 {"refPath":"..."}，适配层在喂给引擎前会把它改回裸字符串，两种都收）。
        //
        // 这里**故意留空**（裸声明 = 运行时再填的空槽）：模板不引用工程里的任何图集资产，
        // 所以你想删哪个示例文件都行，模板不会被牵连。用的时候填成自己的 Flipbook，例如：
        //   DI<SpriteAtlas> Atlas = "{\"Flipbook\":\"/Game/你的目录/你的Flipbook.你的Flipbook\"}";
        //
        // 帧表**不再手写**：DI 在资产加载时（UNiagaraDataInterfaceSpriteAtlas::PostLoad）
        // 从 Flipbook 自动烘出「图集矩形 / 画布矩形 / 画布尺寸 / 贴图尺寸 / 帧率」并存回资产，
        // 源签名（Flipbook 路径 + 帧数 + 帧率 + 每帧 Sprite 的源矩形）没变就不重复烘。
        // ⇒ 换图集 = 只改上面那一行 Flipbook 路径。
        // 手工兜底数据源（AtlasTexture + ManualFrameRects/ManualCanvasRects/ManualCanvasSize/ManualFps）
        // 仍然可用，那种情况下不自动烘。
        DI<SpriteAtlas> Atlas;

        float SizeScale  = 0.5 [ Group="图集"; SortPriority=10;
            Description="1 像素对应多少世界单位（1.0 = 1 厘米，即 UE 默认单位）。面片尺寸 = 目标尺寸 × 这个值：默认 0.5 时画布 928×640 = 4.64×3.2 米，闪电本体约 0.85～1.8 米；想要更大直接乘。" ];
        float FitFrame   = 0.0 [ Group="图集"; SortPriority=12;
            Description="面片取哪个尺寸：0 = 画布还原（面片 = 整块画布 928×640，帧放回它在画布里的位置，默认）；1 = 铺满（面片 = 当前帧自己的矩形）。" ];
        float PlayMode   = 0.0 [ Group="图集"; SortPriority=15;
            Description="播放模式：0 = 按 Flipbook 帧率（默认）；1 = 按粒子生命长度播完一遍；2 = 用 FrameIndex 直接指定帧号。" ];
        float StartFrame = 0.0 [ Group="图集"; SortPriority=20;
            Description="起始帧偏移。接 Random Float in Range 就是随机起帧。" ];
        float FrameIndex = 0.0 [ Group="图集"; SortPriority=25;
            Description="模式2专用：直接指定当前帧号（可接 Float from Curve 做曲线控制）。" ];
        float PlayRate   = 1.0 [ Group="图集"; SortPriority=30;
            Description="播放速率倍率，负值倒放。模式0：1.0 = 正好等于 Flipbook 帧率；模式1：1.0 = 一个生命周期播完一遍。" ];
    }

    Emitter Atlas2D
    {
        Settings = {
            SimTarget          = CPU;      // 数据接口第一步只支持 CPU
            LocalSpace         = false;
            Determinism        = true;
            RandomSeed         = 1337;
            AllocationMode     = Fixed;
            PreAllocationCount = 8;
        }

        EmitterUpdate = {
            // 一次性发射器（2026-10-05 按用户要求改）：只发一发，之后发射器自己收工。
            // 形状照抄工程里能用的 Leng刀光：Self + Once + Complete + LoopDuration = 1.0。
            //   InactiveResponse = Complete ⇒ 粒子全部死光后发射器进入完成状态；
            //   LoopBehavior     = Once     ⇒ 不循环；
            //   LoopDuration     = 1.0      ⇒ 发射器最多活跃 1 秒（粒子自己 0.4 秒就寿终了，
            //                                 这 1 秒是给发射器留的收尾时间）。
            EmitterState(
                LifeCycleMode    = Self,
                InactiveResponse = Complete,
                LoopBehavior     = Once,
                LoopDurationMode = Fixed,
                LoopDuration     = 1.0
            );

            // 唯一的一发：t = 0 立刻生成 1 颗粒子。
            // （之前这里还有 SpawnRate(1.0) 做「每秒一发」的循环发射 —— 一次性特效不需要它了。
            //   顺带记一下当初为什么必须 burst：SpawnRate 走「间隔累加器」
            //   NiagaraEmitterInstanceImpl.cpp:386/1730，每帧累加 SpawnRate × dt、从 0 开始，
            //   SpawnRate=1.0 时第一颗粒子要等满 1 秒才凑够 ⇒ 开头那一秒是空的。）
            SpawnBurst_Instantaneous(SpawnCount = 1, SpawnTime = 0.0);
        }

        ParticleSpawn = {
            // V2 才是非废弃版本（旧的 Spawn/Initialization/InitializeParticle 会报 DFX6004）。
            // LifetimeMode 是静态开关，必须写在它管辖的 Lifetime 之前。
            Spawn/Initialization/V2/InitializeParticle(
                LifetimeMode = DirectSet,
                Lifetime     = 0.4   // 兜底值 = 图集时长（6 帧 ÷ 15 帧/秒）；下一行的模块会按 DI 实际值重算
            );

            // 寿命对齐图集动画的总时长（帧数 ÷ 帧率）—— 用户要的「时长也一样」那半。
            // 必须紧跟 InitializeParticle：寿命要在粒子出生的那一帧定下来
            // （Play_SpriteAtlas 是 ParticleUpdate，那时候改 Lifetime 只会让年龄跳变）。
            Sprite_Atlas_Duration(Atlas = User.Atlas);
        }

        ParticleUpdate = {
            // ParticleState 提供年龄/归一化年龄。没有它 NormalizedAge 永远是 0，
            // 图集就卡在第 0 帧 —— 这是「静默错误」，headless 构建读不到 stack issue。
            ParticleState();

            Play_SpriteAtlas(
                Atlas      = User.Atlas,
                PlayMode   = User.PlayMode,
                SizeScale  = User.SizeScale,
                FitFrame   = User.FitFrame,
                StartFrame = User.StartFrame,
                FrameIndex = User.FrameIndex,
                PlayRate   = User.PlayRate,
                // Loop 显式写死 0.0（只播一遍，播完停在最后一帧）—— **故意不做成用户参数**：
                // 本工程默认就是「一次干净的播放」，想让它循环就把这里改成 1.0
                // （避免面板上留一个改默认值不刷新的存量行 —— 实测踩过）。
                Loop       = 0.0
            );
        }

        SpriteRenderer Sprite
        {
            Material     = "/AtlasFX/M_FXAtlasSheet";
            Alignment    = Unaligned;
            FacingMode   = FaceCamera;
            SortMode     = ViewDepth;
            // 数据接口给的是任意矩形，不是等分网格，所以 Sub Image Size 必须保持 (1,1)，
            // 让 UV 原样 0..1 交给材质函数去换算。
            SubImageSize = (1, 1);

            Bind SpriteSize -> Particles.SpriteSize;
            Bind Color      -> Particles.Color;
        }
    }
}
