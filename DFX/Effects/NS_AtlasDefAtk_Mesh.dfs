// NS_AtlasDefAtk_Mesh —— 同一份 Defatk 图集，改用 **Mesh 渲染器**播放（文本源，DreamFX 生成）。
//
// 和 Sprite 版（NS_AtlasDefAtk）的区别只有三处：
//   1. 多挂一个 /AtlasFX/Modules/Sprite_Atlas_Size —— Mesh 渲染器读 Particles.Scale，
//      不读 Particles.SpriteSize，这个模块把播放模块算好的尺寸换算过去，顺带摆正面片朝向；
//   2. 渲染器从 SpriteRenderer 换成 MeshRenderer；
//   3. 材质不用换 —— /AtlasFX/M_FXAtlasSheet 同时开了精灵和网格两个用法标记。
//
// 采样数学、DI、播放模块三者与 Sprite 版完全一致 ⇒ 两版画面应当逐帧对得上。
//
// 改这个文件后：pwsh -File Plugins/DreamFX/.skill/dfx.ps1 build DFX/Effects/NS_AtlasDefAtk_Mesh.dfs
System(Name="Effects/NS_AtlasDefAtk_Mesh", Root="Plugin.AtlasFX")
{
    Settings = {
        WarmupTime  = 0.0;
        FixedBounds = box(-300, -300, -300, 300, 300, 300);
        ModulePaths = [ "/AtlasFX/Modules" ];
    }

    Properties = {
        DI<SpriteAtlas> Atlas = "{\"Flipbook\":\"/Game/AssetMaterial/FXs/通用Flipbook/Defatk1.Defatk1\"}";

        float SizeScale  = 1.0 [ Group="图集"; SortPriority=10;
            Description="1 像素对应多少世界单位（1.0 = 1 厘米，即 UE 默认单位）。画布 928×640 = 9.28×6.4 米。" ];
        float FitFrame   = 0.0 [ Group="图集"; SortPriority=12;
            Description="面片取哪个尺寸：0 = 画布还原（面片 = 整块画布 928×640，默认）；1 = 铺满（面片 = 当前帧自己的矩形）。" ];
        float PlayMode   = 0.0 [ Group="图集"; SortPriority=15;
            Description="播放模式：0 = 按 Flipbook 帧率（默认，Defatk1 = 15 帧/秒）；1 = 按粒子生命长度播完一遍；2 = 用 FrameIndex 直接指定帧号。" ];
        float StartFrame = 0.0 [ Group="图集"; SortPriority=20;
            Description="起始帧偏移。接 Random Float in Range 就是随机起帧。" ];
        float FrameIndex = 0.0 [ Group="图集"; SortPriority=25;
            Description="模式2专用：直接指定当前帧号（可接 Float from Curve 做曲线控制）。" ];
        float PlayRate   = 1.0 [ Group="图集"; SortPriority=30;
            Description="播放速率倍率，负值倒放。" ];

        // ---- Mesh 渲染器专属 ----
        // 朝向（MeshYaw）**故意不做成用户参数**：本工程的答案恒为 -90，写死在下面的模块调用里。
        // 做成用户参数只会多一个面板行，而且改它的默认值**不会**刷新资产里的存量值
        // （重编不重置用户参数 —— 实测踩过，面板上会一直显示旧值，看着像 bug）。
        // 换网格（比如作者化成「法线 X、宽 Y、高 Z」的工程面片）时直接改下面调用里的 -90.0 即可。
        float DepthScale = 1.0 [ Group="图集|网格"; SortPriority=40;
            Description="厚度（网格局部 Y 方向的缩放）。真正的平面网格保持 1.0；拿 Cube 当薄片用时调小，例如 0.05 = 5 厘米厚。" ];
    }

    Emitter DefAtkMesh
    {
        Settings = {
            SimTarget          = CPU;      // 数据接口第一步只支持 CPU
            LocalSpace         = true;     // 本地空间：粒子不随发射器移动（跟随特效挂点/角色走）
            Determinism        = true;
            RandomSeed         = 1337;
            AllocationMode     = Fixed;
            PreAllocationCount = 8;
        }

        EmitterUpdate = {
            EmitterState(LifeCycleMode = Self, LoopBehavior = Infinite);
            SpawnBurst_Instantaneous(SpawnCount = 1, SpawnTime = 0.0);
            SpawnRate(SpawnRate = 1.0);
        }

        ParticleSpawn = {
            Spawn/Initialization/V2/InitializeParticle(
                LifetimeMode = DirectSet,
                Lifetime     = 1.0
            );
        }

        ParticleUpdate = {
            // 顺序要紧：ParticleState 给年龄 → Play_SpriteAtlas 算帧并写 SpriteSize
            // → Sprite_Atlas_Size 读 SpriteSize 换算 Scale 并摆正朝向。Niagara 按栈序执行。
            ParticleState();

            Play_SpriteAtlas(
                Atlas      = User.Atlas,
                PlayMode   = User.PlayMode,
                SizeScale  = User.SizeScale,
                FitFrame   = User.FitFrame,
                StartFrame = User.StartFrame,
                FrameIndex = User.FrameIndex,
                PlayRate   = User.PlayRate
            );

            // ⚠️ MeshYaw 显式写死 -90.0，**不要**传 User.MeshYaw：
            //    资产里的用户参数 MeshYaw 还存着旧值（重编不会重置用户参数 —— 实测踩过），
            //    传它就可能把面片转成侧对镜头 ⇒ 完全看不见。
            //    -90 的含义：FXDefault 的面法线在局部 Y 上，绕 Z 转 -90° 后法线落到 X 上，
            //    正对本工程 2D 相机（沿 X 轴看）。配合下面的 FacingMode 默认值，
            //    面片就固定在发射器局部平面里、并可以跟着发射器/挂点一起转。
            Sprite_Atlas_Size(
                MeshSize   = (92.8, 64.0),
                DepthScale = User.DepthScale,
                MeshYaw    = -90.0
            );
        }

        MeshRenderer Mesh
        {
            // 用工程自己的面片（ZDBridge 插件里的 FXDefault）而不是引擎自带 Cube。
            // FXDefault 是一张平躺在 X–Z 平面里的面片：**面法线在局部 Y 上**，
            // 宽沿局部 X（92.8）、高沿局部 Z（64.0），轴心在底边。
            // 本工程 2D 相机沿 X 轴看（见 Leng刀光 里 AddVelocity 沿 Y 飞的写法），
            // 所以要靠 Sprite_Atlas_Size 的 MeshYaw = -90 把法线从 Y 转到 X。
            Meshes     = ["/ZDBridge/FX/FXDefault"];

            // ⚠️ 网格渲染器**没有** Material 字段（NiagaraMeshRendererProperties.h:196
            //    "If Override Material is not specified, the mesh's material is used."），
            //    要挂自己的材质必须走「启用材质重载」这两个属性。写 Material = "..." 会被
            //    DreamFX 静默丢掉（它按反射找 FObjectProperty "Material"，网格渲染器上找不到，
            //    直接 return true 什么都不报）—— 这是踩过的坑。
            //
            // ⚠️ 只写 OverrideMaterials 数组还不够！引擎里是**两个**属性：
            //    `bOverrideMaterials`（NiagaraMeshRendererProperties.h:226，界面上的「启用材质重载」，
            //    构造函数默认 false —— NiagaraMeshRendererProperties.cpp:424 `bOverrideMaterials(false)`）
            //    和 `OverrideMaterials` 数组（:273）。渲染时只看前者（:917 / :1140
            //    `if (bOverrideMaterials)`），不勾选就仍然用网格自带的材质（FXDefault 上是
            //    WorldGridMaterial ⇒ 画面上是灰白棋盘格）。DreamFX 只认识数组那个，开关得自己写。
            OverrideMaterials  = ["/AtlasFX/M_FXAtlasSheet"];
            bOverrideMaterials = true;
            // 子图不混合：一帧一帧硬切，不做相邻子图之间的插值（工程里 Leng刀光 也是 false）。
            // 网格渲染器构造函数默认是 true（NiagaraMeshRendererProperties.cpp:426），
            // 版本升级路径又会把它改成 false（:603），所以新旧资产值不一样。
            bSubImageBlend     = false;

            // ── 朝向：**故意不写 FacingMode**，走默认的 Default（本地空间朝向）──────
            // 这是本工程网格特效的标准做法 —— 参考 /Game/GameActor2D/SAO_Kirito/ExAsset/Leng刀光，
            // 它的 MeshRenderer 块里同样没有 FacingMode 这一行。
            //
            // 引擎机制（NiagaraMeshParticleUtils.ush）：
            //   `:365 if (FacingMode != MESH_FACING_DEFAULT)` 才计算并乘上朝向矩阵
            //   `:369 SRT.Rotation = mul(SRT.Rotation, FacingMat)` —— 朝向矩阵在粒子自身旋转
            //   **之后**叠加，等于**覆盖**掉粒子写的旋转。
            //   `:262 FacingDir = -CameraForwardDir`、`:305 RefVector = Params.CameraUpDir`
            //   ⇒ CameraPlane/CameraPosition/Velocity 这三种模式都是"每帧拿相机重建朝向"。
            //
            // 所以 Default 与 CameraPlane 的区别是本质性的：
            //   Default      = 完全不套朝向矩阵 ⇒ 网格保持自己的局部朝向，可以被特效旋转，
            //                  配合发射器 LocalSpace = true，面片跟着发射器/挂点一起转。
            //   CameraPlane  = 每帧朝相机 ⇒ **特效永远转不动它**（CameraPlane 下
            //                  Particles.MeshOrientation 写了也白写），而且始终跟随相机。
            //                  实测现象：拖动视口时面片跟着相机转、色彩线抖动。
            // 我们要的是前者：2D 特效的面片应当固定在发射器局部平面里，由 MeshYaw 摆正到
            // 游戏相机方向，而不是让编辑器自由相机牵着走。
            SortMode = ViewDepth;

            // 排序：和 Leng刀光 一样按归一化年龄排，同一时刻的帧前后关系稳定。
            Bind CustomSorting -> Particles.NormalizedAge;

            Bind Scale -> Particles.Scale;
            Bind Color -> Particles.Color;
        }
    }

}
